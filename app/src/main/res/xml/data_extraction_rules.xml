<?xml version="1.0" encoding="utf-8"?>
<!--
    Excludes every domain from both cloud backup and device-to-device transfer.

    The same reasoning as `backup_rules.xml` applies on Android 12+, with one
    addition: a direct device transfer would move the encrypted database but not the
    Keystore-wrapped key, leaving the user with a journal that cannot be decrypted
    and no way to recover it. Transferring nothing is recoverable; transferring a
    half-copy is not. The in-app export remains the supported migration path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="external"
            path="." />
        <exclude
            domain="device_root"
            path="." />
        <exclude
            domain="device_file"
            path="." />
        <exclude
            domain="device_database"
            path="." />
        <exclude
            domain="device_sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="external"
            path="." />
        <exclude
            domain="device_root"
            path="." />
        <exclude
            domain="device_file"
            path="." />
        <exclude
            domain="device_database"
            path="." />
        <exclude
            domain="device_sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
